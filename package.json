    "@sinclair/typebox": "0.34.48"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "pi": { "extensions": ["./vendor/pi-fff/src/index.ts"] }
}
